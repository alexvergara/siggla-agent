# ─── LLM provider ───────────────────────────────────────────────
# Which provider the agent uses: "zai" (default) or "anthropic".
LLM_PROVIDER=zai

# Z.ai (GLM) — OpenAI-compatible API. Get a key at https://z.ai
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
ZAI_MODEL=glm-4.6

# Anthropic (alternative provider) — only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Sampling
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# ─── Bot identity ───────────────────────────────────────────────
BOT_ALIAS=Siggi
BOT_HEADER=🤖 Siggi · asistente virtual de Sigg.la

# ─── Usage limiter (cost / safety) ──────────────────────────────
# Hard ceiling of total tokens (input+output) per calendar day.
MAX_TOKENS_PER_DAY=100000
# Max inbound messages handled per contact per hour (anti-spam / anti-loop).
MAX_MESSAGES_PER_CONTACT_PER_HOUR=20

# ─── Telegram hot-lead notifier ─────────────────────────────────
# Create a bot via @BotFather, get the token; get your chat id via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── WhatsApp (Baileys) ─────────────────────────────────────────
# Owner control keywords sent FROM the linked number inside a chat.
WA_MUTE_KEYWORD=/stop
WA_UNMUTE_KEYWORD=/start
# Where Baileys persists the linked-device credentials.
WA_AUTH_DIR=./auth_state

# ─── Storage ────────────────────────────────────────────────────
DB_PATH=./data/siggla-agent.sqlite

# Path to the curated knowledge base (relative to where the process runs).
KB_PATH=src/kb/knowledge-base.md

# How many prior turns to keep in context per contact.
HISTORY_TURNS=12
